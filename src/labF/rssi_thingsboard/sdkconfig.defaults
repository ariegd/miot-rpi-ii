# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
# Configuración para usar una tabla de particiones personalizada
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Configuración de WiFi
CONFIG_ESP_WIFI_SSID="SECRET_WIFI_SSID"
CONFIG_ESP_WIFI_PASSWORD="SECRET_WIFI_PASSWORD"
CONFIG_ESP_MAXIMUM_RETRY=5

# Configuración de Provisionamiento ThingsBoard
CONFIG_TB_PROVISION_KEY="PROVISION_KEY"
CONFIG_TB_PROVISION_SECRET="PROVISION_SECRET"

# Configuración de Servidor
CONFIG_MQTT_BROKER_HOST="mqtt.eu.thingsboard.cloud"
